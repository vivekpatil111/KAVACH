# Docket Risk / Ring Sentinel - Environment Configuration Template
# Copy this file to .env for local Docker Compose deployment

# PostgreSQL Configuration (for production durable storage migration)
POSTGRES_USER=ring_sentinel
POSTGRES_PASSWORD=replace_with_a_secure_random_password
POSTGRES_DB=ring_sentinel

# Service Thresholds
RING_SENTINEL_HIGH=0.85
RING_SENTINEL_MEDIUM=0.50

# API Security (Comma-separated API keys)
RING_SENTINEL_API_KEYS=dev-insecure-key-change-me
